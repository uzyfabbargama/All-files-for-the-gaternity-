import Keyword

Mapa {
	Object : list {
		X : int _
		Y : int _
		Z : int _
	}
}

Personaje {
	Vida : int 20
	Nombre : str _"
	Item : int _
	MoveX : int 0
	MoveY : int 0
	MoveZ : int 0
	X : int 0+MoveX
	Y : int 0+MoveZ
	Z : int 0+MoveY
	SeeX : int X+1
	SeeY : int Y+1
	SeeZ : int Z+1
	SeeMX : int X-1
	SeeMY : int Y-1
	SeeMZ : int Z-1
	reglas : code { // se ejecuta en bucle
		// colisiones
		if (Mapa.Object.X == Personaje.SeeX || Mapa.X == Personaje.SeeMX) {
			MoveX == 0
		}
		if (Mapa.Object.Y == Personaje.SeeY || Mapa.Object.Y == Personaje.SeeMY) {
			MoveY == 0
		}
		if (Mapa.Z == Personaje.SeeZ || Mapa.Object.Z == Personaje.SeeMZ) {
			MoveZ == 0
		}
		if (Keyword.Key("w")) {
			MoveZ += 1
		} else {
			MoveZ -= min(0, 1) // restar 1, excepto si es 0
		}
		if (Keyword.Key("s")) {
			MoveZ -= 1
		} else {
			Move += max(0, 1) // sumar 1, excepto si es 0
		}
		if (Keyword.Key("d")) {
			MoveX += 1
		} else {
			MoveX -= min(0, 1) 
		}
		if (Keyword.Key("a")) {
			MoveX -= 1
		}else {
			MoveX -= max(0, 1)
		}

	}
}
