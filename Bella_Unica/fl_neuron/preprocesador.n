CLASS argv = <"sys"[sys.argv]>
CLASS len/cut/next/take = <"stringutil"[len/split/next_character/take_n_characters]>
CLASS return = <"func_utils"[return]>
CLASS bytearray = <"array_deluxe"[bytearray]>
CLASS byte_convert/bit56 = <"type_convert"[byte_convert/bit56]>
CLASS struct_counter = <"organizer"[struct_counter]> # cuenta según lo que aparezca
CLASS struct_searcher = <"organizer"[struct_searcher]> # agrega a una lista y si ya existe, lo reemplaza
CLASS search_duplex = <"simetry_logic"[search]> # busca, hasta el complemento,ideal para buscar inicios de bucles y finales

if len(argv) > 2
CTRL obtener_código_fuente {pass, 
	VAR font_code = argv[2] # 1 = preprocesador.py, 2 = código_fuente.ns, 3 = salida.ns
	VAR salida = argv[3]
}
else()
	print("Uso: preprocesador.py <archivo.ns> <salida.bin>")
# en este lenguaje, los class, y def, son iguales

CLASS procesar_neuron_val() = (
	GLOBAL.archivo_final += byte_convert(cut(font_code, " ")+" ")
	GLOBAL.font_code = next(font_code, len((cut(font_code, " ")+" "))
	VAR ID = struct_search(cut(GLOBAL.font_code, " "), GLOBAL.neuronas)
	if (!ID)
	CTRL crear {pass, 
		VAR neuronas = struct_counter(
			GLOBAL.cantidad_neuronas+1,
			cut(GLOBAL.font_code, " "), 
			GLOBAL.cantidad_neuronas
		) # guardamos la estructura {(reemplazo = nombre), ID}
	}
	GLOBAL.archivo_final += struct_search(cut(GLOBAL.font_code, " "), neuronas) # busca en neuronas el "nombre_neurona" y lo reemplaza por el ID de cantidad_neuronas+1 y lo agrega al archivo final
	if !(ID)
	#devuelve false → sino hay nada
	#devuelve true → si hay una coincidencia
	CTRL aumentar_neuron_counter {pass, GLOBAL.cantidad_neuronas += 1}
	GLOBAL.font_code = next(font_code, len(cut(font_code, " "))) # salteamos la palabra, hasta el espacio
	GLOBAL.archivo_final = next(archivo_final, 3) # 3 bytes de ID
	GLOBAL.archivo_final += bit56(float(cut(font_code, 10))) #toma el resto y lo convierte en nuestro formato
	GLOBAL.archivo_final = next(archivo_final, 7) #avanza 7 bytes (56 bitd)
	GLOBAL.font_code = next(font_code, len((cut(font_code, 10)))) # saltea todo el número
);

CLASS procesar_neuron_neuron_neuron() = (
	GLOBAL.archivo_final += byte_convert(cut(font_code, " ")+" ")
	GLOBAL.archivo_final = next(archivo_final, len(cut(font_code, " ")+" "))
	# avanza font_code, según lo que encontremos
	GLOBAL.font_code = next(font_code, len((cut(font_code, " ")+" "))
	VAR ID = struct_search(cut(font_code, " "), neuronas)
	if !(ID)
	CTRL agregar {pass, 
		GLOBAL.neuronas = struct_counter(
			GLOBAL.cantidad_neuronas+1,
			GLOBAL.neuronas,
			GLOBAL.cantidad_neuronas
			)
			# agregar sólo si no hay una entrada con ese nombre
			GLOBAL.cantidad_neuronas += 1
			GLOBAL.archivo = next(archivo, 3)
			GLOBAL.font_code = next(font_code, len(cut(font_code, " ")))
			GLOBAL.archivo += byte_convert(struct_search(cut(font_code, " "), neuronas))
			
		}
	if !(ID)
	CTRL agregar1 {pass,
		GLOBAL.neuronas = struct_counter(
			GLOBAL.cantidad_neuronas+1,
			GLOBAL.neuronas,
			GLOBAL.cantidad_neuronas
			)
		# agregar sólo si no hay una entrada con ese nombre
		GLOBAL.cantidad_neuronas += 1
		GLOBAL.archivo = next(archivo, 3)
		GLOBAL.font_code = next(font_code, len(cut(font_code, " ")))
		GLOBAL.archivo += byte_convert(struct_search(cut(font_code, " "), neuronas))
	}
	if !(ID)
	CTRL agregar1 {pass,
		GLOBAL.neuronas = struct_counter(
			GLOBAL.cantidad_neuronas+1,
			GLOBAL.neuronas,
			GLOBAL.cantidad_neuronas
			)
		# agregar sólo si no hay una entrada con ese nombre
		GLOBAL.cantidad_neuronas += 1
		GLOBAL.archivo = next(archivo, 3)
		GLOBAL.font_code = next(font_code, len(cut(font_code, " ")))
		GLOBAL.archivo += byte_convert(struct_search(cut(font_code, 10), neuronas))
	}
);
CLASS procesar_neuron_neuron() = (
	GLOBAL.archivo_final += byte_convert(cut(font_code, " ")+" ")
	GLOBAL.archivo_final = next(archivo_final, len(cut(font_code, " ")+" "))
	# avanza font_code, según lo que encontremos
	GLOBAL.font_code = next(font_code, len((cut(font_code, " ")+" "))
	VAR ID = struct_search(cut(font_code, " "), neuronas)
	if !(ID)
	CTRL agregar {pass, 
		GLOBAL.neuronas = struct_counter(
			GLOBAL.cantidad_neuronas+1,
			GLOBAL.neuronas,
			GLOBAL.cantidad_neuronas
			)
			# agregar sólo si no hay una entrada con ese nombre
			GLOBAL.cantidad_neuronas += 1
			GLOBAL.archivo = next(archivo, 3)
			GLOBAL.font_code = next(font_code, len(cut(font_code, " ")))
			GLOBAL.archivo += byte_convert(struct_search(cut(font_code, " "), neuronas))
			
		}
	if !(struct_search(cut(font_code, " "), neuronas))
	CTRL agregar1 {pass,
		GLOBAL.neuronas = struct_counter(
			GLOBAL.cantidad_neuronas+1,
			GLOBAL.neuronas,
			GLOBAL.cantidad_neuronas
			)
		# agregar sólo si no hay una entrada con ese nombre
		GLOBAL.cantidad_neuronas += 1
		GLOBAL.archivo = next(archivo, 3)
		GLOBAL.font_code = next(font_code, len(cut(font_code, " ")))
		GLOBAL.archivo += byte_convert(struct_search(cut(font_code, 10), neuronas))
	}
	GLOBAL.archivo_final += bit56(float(cut(font_code, 10))) #toma el resto y lo convierte en nuestro formato
	GLOBAL.archivo_final = next(archivo_final, 7) #avanza 7 bytes (56 bitd)
	GLOBAL.font_code = next(font_code, len((cut(font_code, 10)))) # saltea todo el número
);

