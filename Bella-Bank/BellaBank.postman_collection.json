{
  "info": {
    "name": "BellaBank API - Unidad 4",
    "description": "Colección de pruebas para autenticación JWT, RBAC, IDOR y rate limiting.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "billCode", "value": "" }
  ],
  "item": [
    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "Registrar usuario A (neo)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"neo\",\n  \"password\": \"Matrix123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] }
          }
        },
        {
          "name": "Registrar usuario B (trinity)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"trinity\",\n  \"password\": \"Zion123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] }
          }
        },
        {
          "name": "Login neo (guarda tokens)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"neo\",\n  \"password\": \"Matrix123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
          }
        },
        {
          "name": "Login con password incorrecta (401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"neo\",\n  \"password\": \"mala\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
          }
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api","auth","refresh"] }
          }
        },
        {
          "name": "Logout (revoca refresh)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api","auth","logout"] }
          }
        }
      ]
    },
    {
      "name": "02 - Bank (requiere token)",
      "item": [
        {
          "name": "Ver saldo",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/bank/balance", "host": ["{{baseUrl}}"], "path": ["api","bank","balance"] }
          }
        },
        {
          "name": "Depositar 500.00",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amountCents\": 50000\n}" },
            "url": { "raw": "{{baseUrl}}/api/bank/deposit", "host": ["{{baseUrl}}"], "path": ["api","bank","deposit"] }
          }
        },
        {
          "name": "Invertir 100.00",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amountCents\": 10000\n}" },
            "url": { "raw": "{{baseUrl}}/api/bank/invest", "host": ["{{baseUrl}}"], "path": ["api","bank","invest"] }
          }
        },
        {
          "name": "Verificar inversión",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/bank/invest/check", "host": ["{{baseUrl}}"], "path": ["api","bank","invest","check"] }
          }
        },
        {
          "name": "Emitir cheque 50.00 (guarda código)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.codigo) pm.collectionVariables.set('billCode', json.codigo);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"amountCents\": 5000,\n  \"concept\": \"pago a trinity\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/bank/bills", "host": ["{{baseUrl}}"], "path": ["api","bank","bills"] }
          }
        },
        {
          "name": "Cobrar cheque (con token de quien lo cobra)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"code\": \"{{billCode}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/bank/bills/redeem", "host": ["{{baseUrl}}"], "path": ["api","bank","bills","redeem"] }
          }
        },
        {
          "name": "MIS facturas (IDOR-safe)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/bank/bills/mine", "host": ["{{baseUrl}}"], "path": ["api","bank","bills","mine"] }
          }
        },
        {
          "name": "Ver factura de OTRO usuario (debe dar 403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/bank/bills/1", "host": ["{{baseUrl}}"], "path": ["api","bank","bills","1"] }
          }
        }
      ]
    },
    {
      "name": "03 - Shop",
      "item": [
        {
          "name": "Catálogo (público)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/shop/catalog", "host": ["{{baseUrl}}"], "path": ["api","shop","catalog"] }
          }
        },
        {
          "name": "Comprar ítem (genera factura)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"diamante\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/shop/purchase", "host": ["{{baseUrl}}"], "path": ["api","shop","purchase"] }
          }
        },
        {
          "name": "Agregar ítem (USER debe dar 403)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"esmeralda\",\n  \"stock\": 10,\n  \"price\": 8000\n}" },
            "url": { "raw": "{{baseUrl}}/api/shop/items", "host": ["{{baseUrl}}"], "path": ["api","shop","items"] }
          }
        }
      ]
    },
    {
      "name": "04 - Seguridad (casos negativos)",
      "item": [
        {
          "name": "Sin token (401)",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/bank/balance", "host": ["{{baseUrl}}"], "path": ["api","bank","balance"] }
          }
        },
        {
          "name": "Token falso (403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer faketoken.abc.def" }],
            "url": { "raw": "{{baseUrl}}/api/bank/balance", "host": ["{{baseUrl}}"], "path": ["api","bank","balance"] }
          }
        },
        {
          "name": "Rate limit login (correr 6 veces)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"neo\",\n  \"password\": \"fuerzabruta\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
          }
        }
      ]
    }
  ]
}
