CLASS gnulmod = <"net.mcreator"[gnulmod]>

CLASS * = <"toolkit.n"[if/else/while/for/switch/json/bif]> 
CLASS var_64 = <"super_var.n"[Super_var4dw]> 
CLASS var_32 = <"super_var.n"[Super_var2dw]>
CLASS boolean = <"typescript.n[bool]">
CLASS null = <"typescript.n[null]">
CLASS math = <"math.n"[math]>
CLASS ternary = <"trinary"[ternary]>
CLASS flow_state = <"flow.n"[flow_control]>
VAR pass = 1
VAR cut = 0

CLASS @ = <"Java_anottations"[*]>
CLASS super = <"super_java64"[super_instancer]>
CLASS World = <"net.minecraft.world.[World]>
CLASS EntityPlayer = <"net.minecraft.entity.player"[EntityPlayer]>
CLASS EntityPlayer = <"net.mcreator.gnulmod"[Gnulmod]>
CLASS GuiGnulStatus = <"net.mcreator.gnulmod.gui"[GuiGnulStatus]>
CLASS ElementsGnulmod = <"net.mcreator.gnulmod"[ElementsGnulmod]>

CLASS  = <"java.util"[Map]>
@(ElementsGnulmod.ModElement.Tag)
CLASS ProcedureGuidetailsOnKeyPressed = ElementsGnulmod.ModElement

ProcedureGuidetailsOnKeyPressed+= (
	super(instance, 10)
	CLASS executeProcedure(Map(<String, Object>), dependencies) = (
		VAR flow = 1
		CTRL not_perfect {cut, flow |= 1} #si uno falla, flow no se da
		if (!dependencies.get("entity") == null) not_perfect,
		if (!dependencies.get("world") == null) not_perfect,
		if (!dependencies.get("x") == null) not_perfect,
		if (!dependencies.get("y") == null) not_perfect,
		if (!dependencies.get("z") == null) not_perfect,
		
		VAR is_flow(1) += flow
		flow_state(7,
			EntityPlayer entity = (EntityPlayer) dependencies.get("entity");
			World world = (World) dependencies.get("world"),
			entity.getEntityData().setInteger("gnul_msg_timer", 200),
			int x = (int) dependencies.get("x"),
			int y = (int) dependencies.get("y"),
			int z = (int) dependencies.get("z"),
			entity.openGui(Gnulmod.instance, GuiGnulStatus.GUIID, world, x, y, z)
		),
	),
	
);
